
<div id="content_element_{{id}}" class="{{class}}">
    <h1>{{ AnimalsCategorie.title }}</h1>
    {{ AnimalsCategorie.description|sanitize_html('contao')|insert_tag_html  }}

    <div class="grid lg:grid-cols-4 md:grid-cols-3 grid-cols-2">

        {% for animalKey, animal in Animals %}
            <div class="card position-relative">
                {% if animal.image %}
                    <a class="stretched-link text-decoration-none" href="javascript:void(0)" data-bs-toggle="dialog" data-bs-target="#Animal_{{ animalKey }}">
                        <figure class="mb-0 ratio-1x1">
                            <img src="{{ animal.image.path|default }}" alt="{{ animal.title }}" class="card-img object-fit-cover h-100">
                                <figcaption class="position-absolute bottom-0 start-50 translate-middle-x">
                                <h4 class="fg-white">{{ animal.title }}</h4>
                            </figcaption>
                        </figure>
                    </a>
                {% endif %}
            </div>
        {% endfor %}


        {% for animalKey, animal in Animals %}
            <dialog class="dialog dialog-scrollable" id="Animal_{{ animalKey }}">
                <div class="dialog-header">
                    <h1 class="dialog-title">{{ animal.title }}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
                </div>

                {% if animal.images %}  
                    <div id="carouselAnimal_{{ animalKey }}" class="carousel carousel-overlay slide">
                        <div class="carousel-inner">
                            {% if animal.images %}  
                                {% for  animalimage in animal.images %}
                                    <div class="carousel-item {{ loop.first ? 'active' }}">
                                        <img src="{{ animalimage.path|default }}" alt="{{ animal.title }}" class="d-block w-100">
                                    </div>
                                {% endfor %}
                            {% endif %}
                            <div class="carousel-overlay-controls">
                                <div>
                                    <button class="btn-icon btn-sm btn-subtle theme-secondary" type="button" data-bs-target="#carouselAnimal_{{ animalKey }}" data-bs-slide="prev">
                                        <span class="carousel-icon-prev" aria-hidden="true"></span>
                                        <span class="visually-hidden">Previous</span>
                                    </button>
                                    <button class="btn-icon btn-sm btn-subtle theme-secondary" type="button" data-bs-target="#carouselAnimal_{{ animalKey }}" data-bs-slide="next">
                                        <span class="carousel-icon-next" aria-hidden="true"></span>
                                        <span class="visually-hidden">Next</span>
                                    </button>
                                </div>
                                <div class="carousel-indicators">
                                    {% if animal.images %}
                                        {% for  animalimage in animal.images %}
                                            <button type="button" data-bs-target="#carouselAnimal_{{ animalKey }}" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' }}" aria-current="true" aria-label="Slide {{ loop.index }}"></button>
                                        {% endfor %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    {% if animal.image %}
                        <img src="{{ animal.image.path|default }}" alt="{{ animal.title }}" class="img-fluid">
                    {% endif %}
                {% endif %}

                <div class="dialog-body">
                    {% if animal.description %} 
                        <h4>{{ 'tl_animals.description.0'|trans({}, 'contao_backend') }}</h4>
                        {{ animal.description|sanitize_html('contao')|insert_tag_html }}
                    {% endif %}
                </div>
            </dialog>
        {% endfor %}
    </div>

</div>